# Local development values. Replace every secret in production.
DATABASE_URL=postgres://pushdocs:pushdocs@localhost:5432/pushdocs
PUSHDOCS_PUBLIC_ORIGIN=http://localhost:3000
PUSHDOCS_SESSION_PEPPER=replace-with-at-least-32-random-characters
PUSHDOCS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
PUSHDOCS_ATTACHMENTS_DIR=./data/attachments
PUSHDOCS_GIT_CACHE_DIR=./data/git
PUSHDOCS_REALTIME_ORIGIN=http://127.0.0.1:4100
# Optional isolated preview. See development/preview.md before enabling.
# PUSHDOCS_PREVIEW_DOMAIN=preview.example.net
# PUSHDOCS_PREVIEW_KEY=replace-with-at-least-32-random-characters
# PUSHDOCS_PREVIEW_IMAGE=your-offline-runtime:tag
# PUSHDOCS_PREVIEW_RUNTIMES={"docs-node20":{"image":"your-offline-runtime:tag","projects":["project-uuid"]}}
# PUSHDOCS_UPLOAD_LIMIT_MIB=64
