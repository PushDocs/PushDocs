{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "scripts/ci/**/*.ts",
    "playwright.ui.config.ts",
    "tests/ui/**/*.ts",
    "tests/ui/**/*.tsx"
  ]
}
