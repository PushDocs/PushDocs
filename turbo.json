{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "PUSHDOCS_ATTACHMENTS_DIR",
    "PUSHDOCS_ENCRYPTION_KEY",
    "PUSHDOCS_PREVIEW_DIR",
    "PUSHDOCS_PREVIEW_PORT_FROM",
    "PUSHDOCS_PREVIEW_PORT_TO",
    "PUSHDOCS_PREVIEW_PUBLIC_HOST",
    "PUSHDOCS_SESSION_PEPPER",
    "PUSHDOCS_VPN_GATEWAY_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/monaco/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
