{$PUSHDOCS_ADDRESS::80} {
	encode zstd gzip

	handle /events* {
		reverse_proxy realtime:4100 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
}

# Live branch previews stay on the Docker network. Caddy is the only service
# that publishes their fixed HTTP port range on the host.
http://:43000 {
	reverse_proxy preview:43000
}

